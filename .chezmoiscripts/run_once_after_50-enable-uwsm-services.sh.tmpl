{{ if .is_fedora -}}
#!/bin/bash
set -euo pipefail

echo ""
echo "🚀 STEP 5/6: Enabling UWSM systemd services..."
echo ""

SERVICES="waybar dunst hyprpaper hypridle hyprpolkitagent"

systemctl --user daemon-reload

for s in $SERVICES; do
  if systemctl --user cat "$s" &>/dev/null; then
    echo "▶️  Enabling and starting $s ..."
    systemctl --user enable --now "$s" 2>&1 || true
  else
    echo "⚠️  Skipping $s (unit not found)"
  fi
done

echo "✅ Services enabled. Check status with: systemctl --user status $SERVICES"
echo ""
{{ end -}}

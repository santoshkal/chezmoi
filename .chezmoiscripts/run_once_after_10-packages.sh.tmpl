{{ if .is_arch -}}
#!/bin/bash
set -euo pipefail

sudo() {
  if [ "$(id -u)" -eq 0 ]; then
    "$@"
  else
    command sudo "$@"
  fi
}

packages=(
  neovim
  tmux
  ripgrep
  fd
  fzf
  bat
  eza
  lazygit
  kubectl
  helm
  eksctl
  aws-cli-v2
  go
  nodejs
  npm
  python
  python-pip
  pyenv
  docker
  docker-compose
  kitty
  i3
  i3blocks
  yazi
  ghostty
)

if command -v yay >/dev/null 2>&1; then
  if [ "$(id -u)" -eq 0 ] && id "_yay" >/dev/null 2>&1; then
    command sudo -u _yay yay -S --noconfirm --needed "${packages[@]}"
  else
    yay -S --noconfirm --needed "${packages[@]}"
  fi
fi

if [ "$(id -u)" -eq 0 ] && id "_yay" >/dev/null 2>&1; then
  userdel -r _yay 2>/dev/null || true
  rm -f /etc/sudoers.d/_yay 2>/dev/null || true
fi

{{ else if .is_fedora -}}
#!/bin/bash
set -euo pipefail

sudo() {
  if [ "$(id -u)" -eq 0 ]; then
    "$@"
  else
    command sudo "$@"
  fi
}

sudo dnf upgrade -y

echo "==> Enabling RPM Fusion repositories..."

sudo dnf install -y \
  "https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm" \
  "https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm"

echo "==> Refreshing repositories..."
sudo dnf makecache

echo "==> Installing multimedia codecs..."

sudo dnf install -y libavcodec-freeworld

sudo dnf copr enable  dejan/lazygit -y
sudo dnf copr enable -y sdegler/hyprland -y

if [ ! -f /etc/yum.repos.d/_copr:copr.fedorainfracloud.org:rivenirvana:lazydocker.repo ]; then
  sudo dnf copr enable -y rivenirvana/lazydocker
fi

sudo dnf update -y

packages=(
  curl
  wget
  flatpak
  git
  nemo
  gedit
  gedit-plugins
  util-linux-user
  openssh-askpass
  openssh
  zsh
  ripgrep
  patch
  hyprland
  hyprpaper
  hypridle
  waybar
  rofi
  dunst
  ncdu
  unzip
  fontconfig
  tmux
  rsync
  pwgen
  btop
  jq
  dnf-plugins-core
  fzf
  neovim
  nodejs
  golang
  gnome-extensions-app
  bsdtar
  compat-lua-devel-5.1.5
  git-delta
  fd-find
  bat
  lazydocker
  zoxide
  pass
)

sudo dnf install -y "${packages[@]}"

# Install tmuxinator
sudo dnf install ruby
gem install tmuxinator

# Install Ghostty
sudo dnf copr enable scottames/ghostty
sudo dnf install ghostty

# Install Docker
sudo dnf config-manager addrepo \
  --from-repofile=https://download.docker.com/linux/fedora/docker-ce.repo \
  --overwrite

sudo dnf remove -y docker-cli podman-docker 2>/dev/null || true

sudo dnf install -y \
  docker-ce \
  docker-ce-cli \
  containerd.io \
  docker-compose-plugin

sudo systemctl enable --now docker
sudo usermod -aG docker "$USER"


# Flatpaks
flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
flatpak install -y flathub com.discordapp.Discord
flatpak install -y flathub com.slack.Slack
flatpak install -y flathub org.chromium.Chromium
flatpak install -y flathub org.gimp.GIMP

{{ else if .is_ubuntu -}}
#!/bin/bash
set -euo pipefail

sudo() {
  if [ "$(id -u)" -eq 0 ]; then
    "$@"
  else
    command sudo "$@"
  fi
}

sudo apt update
sudo env DEBIAN_FRONTEND=noninteractive apt install --yes \
  neovim \
  tmux \
  ripgrep \
  fd-find \
  fzf \
  bat \
  git \
  curl \
  wget \
  unzip \
  golang-go \
  nodejs \
  npm \
  python3 \
  python3-pip \
  docker.io \
  docker-compose

if command -v cargo >/dev/null 2>&1; then
  cargo install --locked eza 2>/dev/null || true
else
  echo "Note: eza not installed (cargo not available). Install manually if needed."
fi

if command -v fdfind >/dev/null 2>&1 && ! command -v fd >/dev/null 2>&1; then
  sudo ln -sf "$(command -v fdfind)" /usr/local/bin/fd 2>/dev/null || true
fi

if command -v batcat >/dev/null 2>&1 && ! command -v bat >/dev/null 2>&1; then
  sudo ln -sf "$(command -v batcat)" /usr/local/bin/bat 2>/dev/null || true
fi

{{ end -}}

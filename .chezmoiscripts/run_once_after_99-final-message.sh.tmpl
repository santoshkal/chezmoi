#!/bin/bash
set -eu

echo ""
echo "🎉 STEP 6/6: Finalizing..."
echo ""

KEY="$HOME/.ssh/github_keys"

if [ -f "$KEY" ]; then
  echo "🔑 Adding GitHub SSH key to agent..."
  if [ -z "${SSH_AUTH_SOCK:-}" ]; then
    eval "$(ssh-agent -s)" >/dev/null
  fi

  ssh-add "$KEY" >/dev/null 2>&1 || true
fi

cat << "EOF"

######################################################
#   ✅ Dotfiles applied successfully!                #
#                                                    #
#  To complete setup:                                #
#    1. Restart your terminal or run: exec zsh       #
#    2. Run :Lazy sync in Neovim to install plugins  #
#    3. Run :Mason in Neovim to install LSP servers  #
#                                                    #
######################################################

EOF
